# Copy to server/.env and fill in. Never commit the real file.
# (Tests use server/.env.test, which points at the careerpilot_test database.)

# --- Database (Postgres in Docker, see docker-compose.yml) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/careerpilot?schema=public"
PORT=3000

# --- Claude API (console.anthropic.com → API keys; set a monthly spend limit) ---
# Scoring/classifying: claude-haiku-5-5. Tailoring/polishing: claude-sonnet-5-5.
ANTHROPIC_API_KEY=

# --- Telegram (how you control the agent) ---
# 1. In Telegram, message @BotFather → /newbot → copy the token here.
# 2. Start the worker, then send /start to your bot. It saves your chat id and ignores everyone else.
TELEGRAM_BOT_TOKEN=

# --- Job sources (all optional; a source with no key is skipped) ---
# Adzuna: free key at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# JSearch (Indeed / Google Jobs listings, discovery only): https://rapidapi.com → JSearch → free plan
RAPIDAPI_KEY=
# Remotive, RemoteOK, Himalayas, Arbeitnow, We Work Remotely, Greenhouse, Lever, Ashby need no key.

# --- Safety ---
# DRY_RUN is stored in Settings (dashboard → Settings) and defaults to ON: forms are filled and
# screenshotted but never submitted. Daily application cap defaults to 15 (hard max).
